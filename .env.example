# Example environment variables for Supabase (Vite expects public vars to start with VITE_)
# Copy this to a local .env (not checked into git) and fill with your real keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend Django secret / DB connection (example)
# SECRET_KEY=django-insecure-... (if needed locally)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

